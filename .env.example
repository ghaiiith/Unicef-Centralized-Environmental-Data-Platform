# Copy to .env and set unique secrets. Never commit .env.
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_SECRET
# Public issuer URL must exactly match JWT iss claim; configure a real OIDC provider.
OIDC_ISSUER=https://identity.example.gov.iq/realms/environment
OIDC_JWKS_URL=https://identity.example.gov.iq/realms/environment/protocol/openid-connect/certs
OIDC_AUDIENCE=environment-api
OIDC_BROWSER_CLIENT_ID=environment-web
ALLOW_HTTP_OIDC=0
VERIFIER_NOTIFICATION_EMAIL=
